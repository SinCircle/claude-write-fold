# Publication allowlist: ignore everything unless explicitly listed here.
# New source files must be reviewed and added to this list before publication.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/VERIFICATION.md
!/inject.py
!/adapter.mjs
!/inject.cmd
!/claude-write-fold.cmd
!/restore-original.cmd

!/vendor/
/vendor/*
!/vendor/acorn.mjs
!/vendor/ACORN-LICENSE

!/tests/
/tests/*
!/tests/check_adapter.py
!/tests/test-adapter.mjs

!/verification/
/verification/*
!/verification/animation-validation.json
!/verification/web-detail-validation.json
!/verification/stream-handoff-validation.json
